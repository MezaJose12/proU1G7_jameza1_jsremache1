@{
    ViewBag.Title = "Home Page";
}

<main class="container py-4">
    <!--Sección Principal-->
    <section class="text-center mb-4">
        <h1 class="h3 fw-bold">Vuela a tu próximo destino</h1>
        <p class="text-secondary mb-0">
            Viajes privados con atención personalizada.
        </p>
    </section>
    <!-- Formulario de búsqueda -->
    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">Encuentra tu vuelo</h2>
            <form action="#" method="get">
                <div class="row g-3">
                    <!-- Origen -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="origen" class="form-label">
                            Origen <span class="text-danger">*</span>
                        </label>

                        <select id="origen" name="origen"
                                class="form-select" required>
                            <option value="Quito" selected>Quito</option>
                            <option value="Guayaquil">Guayaquil</option>
                            <option value="Manta">Manta</option>
                        </select>
                    </div>
                    <!-- Destino -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="destino" class="form-label">
                            Destino <span class="text-danger">*</span>
                        </label>

                        <select id="destino" name="destino"
                                class="form-select" required>
                            <option value="" selected disabled>
                                Seleccionar destino
                            </option>
                            <option value="Guayaquil">Guayaquil</option>
                            <option value="Manta">Manta</option>
                            <option value="Galapagos">Galápagos</option>
                        </select>
                    </div>
                    <!-- Fecha -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="fecha" class="form-label">
                            Fecha de salida
                            <span class="text-danger">*</span>
                        </label>

                        <input type="date" id="fecha" name="fecha"
                               class="form-control" required />
                    </div>
                    <!-- Pasajeros -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="pasajeros" class="form-label">
                            Pasajeros <span class="text-danger">*</span>
                        </label>
                        <select id="pasajeros" name="pasajeros"
                                class="form-select" required>
                            <option value="" selected disabled>
                                Indicar cantidad
                            </option>
                            <option value="1">1 pasajero</option>
                            <option value="2">2 pasajeros</option>
                            <option value="3">3 pasajeros</option>
                            <option value="4">4 pasajeros</option>
                            <option value="5">5 pasajeros</option>
                            <option value="6">6 pasajeros</option>
                            <option value="7">7 pasajeros</option>
                        </select>
                    </div>
                    <!-- Botón de búsqueda -->
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            Buscar vuelos
                        </button>
                        <p class="form-text mb-0">
                            Horarios sujetos a la programación establecida
                            y disponibilidad real.
                        </p>
                    </div>
                </div>
            </form>
        </div>
    </section>
    <div class="row">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <h2 id="gettingStartedTitle">Getting started</h2>
            <p>
                ASP.NET MVC gives you a powerful, patterns-based way to build dynamic websites that
                enables a clean separation of concerns and gives you full control over markup
                for enjoyable, agile development.
            </p>
            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301865">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <h2 id="librariesTitle">Get more libraries</h2>
            <p>NuGet is a free Visual Studio extension that makes it easy to add, remove, and update libraries and tools in Visual Studio projects.</p>
            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301866">Learn more &raquo;</a></p>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <h2 id="hostingTitle">Web Hosting</h2>
            <p>You can easily find a web hosting company that offers the right mix of features and price for your applications.</p>
            <p><a class="btn btn-outline-dark" href="https://go.microsoft.com/fwlink/?LinkId=301867">Learn more &raquo;</a></p>
        </section>
    </div>
</main>