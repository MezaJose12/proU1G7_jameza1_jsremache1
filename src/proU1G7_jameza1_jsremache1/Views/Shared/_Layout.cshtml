<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicacion ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary rounded-4 shadow mx-auto mt-3" style="max-width: 1200px;">
        <div class="container">
            @Html.RouteLink("Aerolinea VIP", "Default", new { controller = "Home", action = "Index" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNavigation" title="Alternar navegacion" aria-controls="mainNavigation" aria-expanded="false" aria-label="Alternar navegacion">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.RouteLink("Buscar vuelos", "FlightSearch", null, new { @class = "nav-link" })</li>
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">@Html.RouteLink("Mis reservas", "MyReservations", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.RouteLink("Check-in", "CheckIn", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.RouteLink("Comprobantes", "Receipts", null, new { @class = "nav-link" })</li>
                    }
                    @if (User.IsInRole("view"))
                    {
                        <li class="nav-item">@Html.RouteLink("Administracion", "AdminHome", null, new { @class = "nav-link" })</li>
                    }
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <div class="aviation-background" aria-hidden="true">
        <div class="sky-glow"></div>
        <span class="flight-plane plane-one">&#9992;</span>
        <span class="flight-plane plane-two">&#9992;</span>
        <span class="flight-plane plane-three">&#9992;</span>
        <span class="sky-cloud cloud-one"></span>
        <span class="sky-cloud cloud-two"></span>
        <span class="sky-cloud cloud-three"></span>
    </div>

    <div class="container body-content position-relative">
        @if (System.Configuration.ConfigurationManager.AppSettings["EnableDemoData"] == "true" && HttpContext.Current.IsDebuggingEnabled)
        {
            <div class="alert alert-warning mt-3 mb-0" role="status">Datos de demostracion habilitados: vuelos y reservas sinteticos para desarrollo, no operaciones reales.</div>
        }
        @RenderBody()
        <footer class="bg-primary text-white mt-5 py-4 rounded-top-4">
            <div class="container text-center">
                <p class="mb-1">&copy; @DateTime.Now.Year - Aerolinea VIP</p>
                <small class="text-white-50">Viaja con comodidad y confianza.</small>
            </div>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
