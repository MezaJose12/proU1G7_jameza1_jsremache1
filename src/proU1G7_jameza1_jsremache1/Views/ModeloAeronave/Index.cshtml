@model IEnumerable<proU1G7_jameza1_jsremache1.Models.ModeloAeronave>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Modelos de aeronave</h2>
@if (ViewBag.Aviso != null)
{
    <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
}
<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Fabricante)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>Capacidad</th>
        <th>Asientos configurados</th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Fabricante)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>@item.CapacidadAsientos</td>
        <td>@item.Asientoes.Count / @item.CapacidadAsientos
            @if (item.Asientoes.Count != item.CapacidadAsientos)
            {
                <span class="text-warning"> - incompleto</span>
            }
        </td>
        <td>
            @Html.ActionLink("Configurar asientos", "Create", "Asiento", new { modeloAeronaveId = item.ModeloAeronaveId }, null) |
            @Html.ActionLink("Editar", "Edit", new { id=item.ModeloAeronaveId }) |
            @Html.ActionLink("Detalle", "Details", new { id=item.ModeloAeronaveId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.ModeloAeronaveId })
        </td>
    </tr>
}

</table>
