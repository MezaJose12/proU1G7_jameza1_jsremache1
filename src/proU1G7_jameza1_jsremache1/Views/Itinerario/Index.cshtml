@model IEnumerable<proU1G7_jameza1_jsremache1.Models.Itinerario>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h2">Itinerarios</h1><p class="text-secondary mb-0">Agrupan vuelos ya programados. Agregue cada vuelo como tramo e indique el orden de conexion.</p></div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Crear itinerario", "Create", null, new { @class = "btn btn-primary" }) }
            @Html.ActionLink("Configurar tramos", "Index", "TramoItinerarios", null, new { @class = "btn btn-outline-primary" }) @Html.RouteLink("Volver al modulo", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </header>
    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
    }
    <div class="table-responsive"><table class="table table-striped table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Referencia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EstadoItinerario.Descripcion)
        </th>
        <th>Tramos</th>
        <th>Acciones</th>
    </tr>
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-secondary">No hay itinerarios registrados.</td></tr>
    }

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Referencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoItinerario.Descripcion)
        </td>
        <td>@item.TramoItinerarios.Count</td>
        <td>
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Agregar tramo", "Create", "TramoItinerarios", new { itinerarioId = item.ItinerarioId }, new { @class = "btn btn-sm btn-outline-primary" }) }
            @Html.ActionLink("Editar", "Edit", new { id = item.ItinerarioId }) |
            @Html.ActionLink("Detalle", "Details", new { id = item.ItinerarioId })
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Eliminar", "Delete", new { id = item.ItinerarioId }) }
        </td>
    </tr>
}

</table></div>
</main>
