@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Inicio";
}

<main class="container py-4">
    <!--Seccion Principal-->
    <section class="text-center mb-4">
        <h1 class="h3 fw-bold">Vuela a tu proximo destino</h1>
        <p class="text-secondary mb-0">
            Viajes privados con atencion personalizada.
        </p>
    </section>
    <!-- Formulario de busqueda -->
    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5 fw-bold mb-3">Encuentra tu vuelo</h2>
            @using (Html.BeginForm("Resultados", "Interfaces", FormMethod.Get, new { id = "formBuscarVuelos" }))
            {
                <div class="row g-3">
                    <!-- Origen -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="origen" class="form-label">
                            Origen <span class="text-danger">*</span>
                        </label>

                        @Html.DropDownList("origen", Model.Aeropuertos, "Seleccionar origen", new { @class = "form-select", id = "origen", required = "required" })
                    </div>
                    <!-- Destino -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="destino" class="form-label">
                            Destino <span class="text-danger">*</span>
                        </label>

                        @Html.DropDownList("destino", Model.Destinos, "Seleccionar destino", new { @class = "form-select", id = "destino", required = "required" })
                    </div>
                    <!-- Fecha -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="fecha" class="form-label">
                            Fecha de salida
                            <span class="text-danger">*</span>
                        </label>

                        <input type="date" id="fecha" name="fecha" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control" required />
                    </div>
                    <!-- Pasajeros -->
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="pasajeros" class="form-label">
                            Pasajeros <span class="text-danger">*</span>
                        </label>
                        <select id="pasajeros" name="pasajeros" class="form-select" required>
                            @for (var cantidad = 1; cantidad <= 7; cantidad++)
                            {
                                <option value="@cantidad" selected="@(cantidad == Model.CantidadPasajeros)">@cantidad pasajero(s)</option>
                            }
                        </select>
                    </div>
                    <!-- Boton de busqueda -->
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            Buscar vuelos
                        </button>
                        <p class="form-text mb-0">
                            Horarios sujetos a la programacion establecida
                            y disponibilidad real.
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>
    <section class="mb-4" aria-labelledby="destinos-title">
        <h2 id="destinos-title" class="h5 fw-bold mb-3">Destinos con rutas activas</h2>
        <div class="row g-3">
            @if (Model.Destinos.Count == 0)
            {
                <div class="col-12"><p class="text-secondary">No hay rutas activas configuradas en este momento.</p></div>
            }
            @foreach (var destino in Model.Destinos)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm"><div class="card-body"><h3 class="h6 card-title">@destino.Text</h3><p class="card-text text-secondary small mb-0">Los dias y horarios se muestran al consultar vuelos.</p></div></article>
                </div>
            }
        </div>
    </section>
</main>