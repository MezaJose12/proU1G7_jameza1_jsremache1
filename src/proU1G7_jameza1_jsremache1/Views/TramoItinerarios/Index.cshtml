@model IEnumerable<proU1G7_jameza1_jsremache1.Models.TramoItinerario>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h2">Tramos de itinerario</h1><p class="text-secondary mb-0">Cada fila vincula un vuelo con un itinerario. El orden debe seguir la secuencia del viaje.</p></div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Agregar tramo", "Create", null, new { @class = "btn btn-primary" }) }
            @Html.ActionLink("Volver a itinerarios", "Index", "Itinerario", null, new { @class = "btn btn-outline-secondary" }) @Html.RouteLink("Volver al modulo", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </header>
    <div class="table-responsive"><table class="table table-striped table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Orden)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Itinerario.Referencia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Vuelo.EstadoVueloCodigo)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Orden)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Itinerario.Referencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Vuelo.EstadoVueloCodigo)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.TramoItinerarioId }) |
            @Html.ActionLink("Detalle", "Details", new { id=item.TramoItinerarioId })
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Eliminar", "Delete", new { id=item.TramoItinerarioId }) }
        </td>
    </tr>
}

</table></div>
</main>
