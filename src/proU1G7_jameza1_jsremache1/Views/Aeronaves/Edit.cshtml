@model proU1G7_jameza1_jsremache1.Models.Aeronave

@{
    ViewBag.Title = "Editar aeronave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Editar aeronave</h2>
<p class="text-secondary">La matricula identifica este avion real (ej.: AV-01). El modelo elegido debe tener el mapa de asientos completo.</p>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Aeronave</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.AeronaveId)

        <div class="form-group">
            @Html.LabelFor(model => model.Matricula, "Matricula / identificador del avion", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Matricula, new { htmlAttributes = new { @class = "form-control", required = "required", maxlength = "15" } })
                @Html.ValidationMessageFor(model => model.Matricula, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ModeloAeronaveId, "Modelo de aeronave", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("ModeloAeronaveId", null, "Seleccione un modelo con asientos configurados", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.ModeloAeronaveId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EstadoAeronaveCodigo, "Estado operativo", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("EstadoAeronaveCodigo", null, "Seleccione un estado", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.EstadoAeronaveCodigo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    @Html.ActionLink("Volver a aeronaves", "Index", null, new { @class = "btn btn-outline-secondary" })
    @Html.RouteLink("Volver a Flota", "AdminAircraft", null, new { @class = "btn btn-outline-secondary" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
