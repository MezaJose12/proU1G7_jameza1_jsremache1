@model proU1G7_jameza1_jsremache1.Models.Frecuencia

@{
    ViewBag.Title = "Crear frecuencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear frecuencia semanal</h2>
<p class="text-secondary">La frecuencia es una plantilla recurrente (ruta, dia y horas), no un vuelo con fecha. Despues genere los vuelos desde el listado de vuelos.</p>


@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Frecuencia</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.RutaId, "Ruta", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("RutaId", null, "Seleccione una ruta", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.RutaId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DiaSemana, "Dia de operacion", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.DiaSemana, (System.Collections.Generic.IEnumerable<System.Web.Mvc.SelectListItem>)ViewBag.DiaSemana, "Seleccione un dia", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.DiaSemana, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HoraSalida, "Hora de salida (hora local)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HoraSalida, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                <small class="form-text text-muted">Formato de 24 horas HH:mm; por ejemplo 09:30.</small>
                @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HoraLlegada, "Hora de llegada (hora local)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.HoraLlegada, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                <small class="form-text text-muted">Formato de 24 horas HH:mm; por ejemplo 11:10.</small>
                @Html.ValidationMessageFor(model => model.HoraLlegada, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.Activa)
                    @Html.ValidationMessageFor(model => model.Activa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Crear frecuencia" class="btn btn-primary" />
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    @Html.ActionLink("Volver a frecuencias", "Index", null, new { @class = "btn btn-outline-secondary" })
    @Html.RouteLink("Volver a Vuelos e itinerarios", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
