@model IEnumerable<proU1G7_jameza1_jsremache1.Models.Ruta>

@{
    ViewBag.Title = "Rutas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Rutas</h2>
@if (ViewBag.Aviso != null)
{
    <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
}
<p>
    @Html.ActionLink("Crear ruta", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TarifaReferencial)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Activa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Aeropuerto.CodigoIATA)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Aeropuerto1.CodigoIATA)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TarifaReferencial)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto.CodigoIATA)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto1.CodigoIATA)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.RutaId }) |
            @Html.ActionLink("Detalle", "Details", new { id=item.RutaId }) |
            @Html.ActionLink("Desactivar o eliminar", "Delete", new { id=item.RutaId })
        </td>
    </tr>
}

</table>
