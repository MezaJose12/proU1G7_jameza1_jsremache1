@model IEnumerable<proU1G7_jameza1_jsremache1.Models.Ruta>

@{
    ViewBag.Title = "Rutas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h2">Rutas</h1><p class="text-secondary mb-0">Cada ruta une dos aeropuertos y tiene una tarifa referencial en USD. Cree sus frecuencias despues.</p></div>
        <div class="d-flex flex-wrap gap-2">
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Crear ruta", "Create", null, new { @class = "btn btn-primary" }) }
            @Html.RouteLink("Volver a Vuelos e itinerarios", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </header>
    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
    }
    <div class="table-responsive"><table class="table table-striped table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TarifaReferencial)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Activa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Aeropuerto.CodigoIATA)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Aeropuerto1.CodigoIATA)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TarifaReferencial)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto.CodigoIATA)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto1.CodigoIATA)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.RutaId }) |
            @Html.ActionLink("Detalle", "Details", new { id=item.RutaId })
            @if (User.IsInRole("Administrador")) { @Html.ActionLink("Desactivar o eliminar", "Delete", new { id=item.RutaId }) }
        </td>
    </tr>
}

</table></div>
</main>
