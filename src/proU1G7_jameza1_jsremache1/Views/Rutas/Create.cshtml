@model proU1G7_jameza1_jsremache1.Models.Ruta

@{
    ViewBag.Title = "Crear ruta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Crear ruta</h2>
<p class="text-secondary">Una ruta conecta dos aeropuertos ya registrados. La frecuencia semanal y los vuelos se crean despues.</p>


@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Ruta</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.AeropuertoOrigenId, "Aeropuerto de origen", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("AeropuertoOrigenId", null, "Seleccione aeropuerto de origen", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.AeropuertoOrigenId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AeropuertoDestinoId, "Aeropuerto de destino", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("AeropuertoDestinoId", null, "Seleccione aeropuerto de destino", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.AeropuertoDestinoId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TarifaReferencial, "Tarifa referencial (USD)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.TarifaReferencial, new { htmlAttributes = new { @class = "form-control", required = "required", min = "0", step = "0.01", placeholder = "Ej.: 125.00" } })
                <small class="form-text text-muted">Monto en USD por pasajero y por tramo; use hasta dos decimales (ej.: 125.00).</small>
                @Html.ValidationMessageFor(model => model.TarifaReferencial, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.EditorFor(model => model.Activa)
                    @Html.ValidationMessageFor(model => model.Activa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    @Html.ActionLink("Volver a rutas", "Index", null, new { @class = "btn btn-outline-secondary" })
    @Html.RouteLink("Volver a Vuelos e itinerarios", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
