@using proU1G7_jameza1_jsremache1.Models
@model LoginViewModel

@{
    ViewBag.Title = "Iniciar sesion";
}

<main class="container py-2" aria-labelledby="title">
    <div class="row justify-content-center">
        <div class="col-12 col-md-7 col-lg-5 col-xl-4">
            <div class="card border-0 shadow rounded-3">
                <div class="card-header bg-primary text-white text-center py-2">
                    <div class="fs-2 lh-1 mb-1">&#9992;</div>
                    <h2 id="title" class="h5 fw-bold mb-1">Bienvenido a bordo</h2>
                    <p class="small mb-0">Accede a tu cuenta de Aerolinea VIP</p>
                </div>
                <div class="card-body p-3">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small mb-2" })

                        <div class="mb-2">
                            @Html.LabelFor(m => m.Email, "Usuario o correo electronico", new { @class = "form-label small fw-semibold mb-1" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm", placeholder = "usuario@ejemplo.com", autocomplete = "username" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-2">
                            @Html.LabelFor(m => m.Password, "Contrasena", new { @class = "form-label small fw-semibold mb-1" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-sm", placeholder = "Ingresa tu contrasena", autocomplete = "current-password" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="form-check mb-2">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small" })
                        </div>

                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-primary btn-sm fw-semibold">Iniciar sesion</button>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between gap-1 small">
                            @Html.ActionLink("Olvido su contrasena?", "ForgotPassword", "Account", null, new { @class = "text-decoration-none" })
                            @Html.ActionLink("Crear cuenta", "Register", "Account", null, new { @class = "text-decoration-none fw-semibold" })
                        </div>
                    }
                </div>
            </div>
            <p class="text-center text-muted small mt-2 mb-0">&#9992; Viaja con comodidad y confianza.</p>
        </div>
    </div>
</main>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}