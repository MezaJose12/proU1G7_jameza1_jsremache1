@model IEnumerable<proU1G7_jameza1_jsremache1.Models.Aeropuerto>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h2">Aeropuertos</h1><p class="text-secondary mb-0">Catalogo de origenes y destinos; registre los aeropuertos antes de crear rutas.</p></div>
        <div class="d-flex flex-wrap gap-2">@Html.ActionLink("Registrar aeropuerto", "Create", null, new { @class = "btn btn-primary" }) @Html.RouteLink("Volver a Vuelos e itinerarios", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })</div>
    </header>
    @if (ViewBag.Aviso != null)
    {
        <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
    }
    <div class="table-responsive"><table class="table table-striped table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.CodigoIATA)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Localidad)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Activo)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CodigoIATA)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Localidad)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activo)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id = item.AeropuertoId }) |
            @Html.ActionLink("Detalle", "Details", new { id = item.AeropuertoId }) |
            @Html.ActionLink("Desactivar o eliminar", "Delete", new { id = item.AeropuertoId })
        </td>
    </tr>
}

</table></div>
</main>
