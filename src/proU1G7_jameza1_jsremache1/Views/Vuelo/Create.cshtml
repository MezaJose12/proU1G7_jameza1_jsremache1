@model proU1G7_jameza1_jsremache1.Models.Vuelo

@{
    ViewBag.Title = "Programar vuelo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Programar vuelo individual</h2>
<p class="text-secondary">Asigne una fecha concreta a una frecuencia y seleccione la aeronave y el estado. Para crear varios vuelos recurrentes use «Generar vuelos semanales» en el listado.</p>


@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Vuelo</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.FrecuenciaId, "Frecuencia semanal (ruta y horario)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("FrecuenciaId", null, "Seleccione una frecuencia", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.FrecuenciaId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.FechaOperacion, "Fecha de operacion", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.FechaOperacion, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                <small class="form-text text-muted">Seleccione la fecha calendario en que se realizara este vuelo.</small>
                @Html.ValidationMessageFor(model => model.FechaOperacion, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.AeronaveId, "Aeronave (matricula)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("AeronaveId", null, "Seleccione una aeronave", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.AeronaveId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.EstadoVueloCodigo, "Estado del vuelo", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("EstadoVueloCodigo", null, "Seleccione un estado", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.EstadoVueloCodigo, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    @Html.ActionLink("Volver a vuelos programados", "Index", null, new { @class = "btn btn-outline-secondary" })
    @Html.RouteLink("Volver a Vuelos e itinerarios", "AdminFlights", null, new { @class = "btn btn-outline-secondary" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
