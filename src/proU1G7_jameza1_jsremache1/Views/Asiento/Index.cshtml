@model IEnumerable<proU1G7_jameza1_jsremache1.Models.Asiento>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Asientos</h2>
@if (ViewBag.Aviso != null)
{
    <div class="alert alert-info" role="status">@ViewBag.Aviso</div>
}
<p>
    @Html.ActionLink("Crear asiento", "Create", null, new { @class = "btn btn-primary" })
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Codigo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Fila)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Lado)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Ubicacion)
        </th>
        <th>Modelo</th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Codigo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Fila)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Lado)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Ubicacion)
        </td>
        <td>@item.ModeloAeronave.Fabricante @item.ModeloAeronave.Nombre</td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { modeloAeronaveId = item.ModeloAeronaveId, numeroAsiento = item.NumeroAsiento }) |
            @Html.ActionLink("Detalle", "Details", new { modeloAeronaveId = item.ModeloAeronaveId, numeroAsiento = item.NumeroAsiento }) |
            @Html.ActionLink("Eliminar", "Delete", new { modeloAeronaveId = item.ModeloAeronaveId, numeroAsiento = item.NumeroAsiento })
        </td>
    </tr>
}

</table>
