@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Resultados de vuelos";
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 6 - Resultados</p>
            <h1 id="page-title" class="h2 fw-bold">Resultados de vuelos</h1>
            <p class="text-secondary mb-0">@Model.Origen -> @Model.Destino - @(Model.FechaViaje.HasValue ? Model.FechaViaje.Value.ToString("dd/MM/yyyy") : "Fecha no seleccionada") - @Model.CantidadPasajeros pasajero(s)</p>
        </div>
        @Html.ActionLink("Modificar busqueda", "Buscar", "Interfaces", null, new { @class = "btn btn-outline-secondary" })
    </header>
    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-info" role="status">@Model.Mensaje</div>
    }
    @if (Model.Vuelos.Count == 0)
    {
        <section class="card border-0 shadow-sm"><div class="card-body text-center py-5">
            <div class="display-6 text-primary mb-2" aria-hidden="true">></div>
            <h2 class="h5">No se encontraron vuelos</h2>
            <p class="text-secondary">No mostramos horarios ficticios. Prueba otra fecha o modifica la ruta.</p>
            @Html.ActionLink("Modificar busqueda", "Buscar", "Interfaces", null, new { @class = "btn btn-primary" })
        </div></section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var vuelo in Model.Vuelos)
            {
                <div class="col-12">
                    <article class="card shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center g-3">
                                <div class="col-12 col-md-3"><span class="badge text-bg-light border">@vuelo.CodigoVuelo</span><h2 class="h5 mt-2 mb-1">@vuelo.HoraSalida - @vuelo.HoraLlegada</h2><span class="text-secondary">@vuelo.Fecha.ToString("ddd dd/MM/yyyy")</span></div>
                                <div class="col-12 col-md-4"><strong>@vuelo.Origen -> @vuelo.Destino</strong><div class="small text-secondary">Aeronave @vuelo.Matricula - @vuelo.Estado</div></div>
                                <div class="col-6 col-md-2"><span class="badge @(vuelo.AsientosDisponibles > 0 ? "text-bg-success" : "text-bg-secondary")">@vuelo.AsientosDisponibles / 7 asientos disponibles</span></div>
                                <div class="col-6 col-md-3 text-md-end"><div class="fw-bold mb-2">@vuelo.Tarifa.ToString("N2") @vuelo.Moneda <small class="text-secondary fw-normal">por tramo</small></div>
                                    @Html.RouteLink("Consultar disponibilidad", "FlightAvailability", new { id = vuelo.VueloId }, new { @class = "btn btn-outline-primary btn-sm mb-1" })
                                    @if (vuelo.AsientosDisponibles >= Model.CantidadPasajeros)
                                    {
                                        if (Request.IsAuthenticated)
                                        {
                                            @Html.RouteLink("Seleccionar vuelo", "SeatSelection", new { id = vuelo.VueloId }, new { @class = "btn btn-primary btn-sm mb-1" })
                                        }
                                        else
                                        {
                                            @Html.ActionLink("Iniciar sesion para reservar", "Login", "Account", new { ReturnUrl = Url.RouteUrl("SeatSelection", new { id = vuelo.VueloId }) }, new { @class = "btn btn-primary btn-sm mb-1" })
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Sin capacidad suficiente</span>
                                    }
                                </div>
                            </div>
                            <details class="mt-3"><summary class="text-primary">Ver detalles y disponibilidad</summary><p class="small text-secondary mt-2 mb-0">La disponibilidad corresponde al vuelo y fecha consultados. El servidor revalidara los asientos antes de registrar una reserva.</p></details>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</main>
