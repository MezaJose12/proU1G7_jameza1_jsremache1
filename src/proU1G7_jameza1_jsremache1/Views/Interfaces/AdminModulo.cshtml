@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Modulo administrativo";
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla @ViewBag.NumeroPantalla - Administracion</p><h1 id="page-title" class="h2 fw-bold">@ViewBag.TitleModulo</h1>
    @if (Model.AccesosAdministrativos.Count == 0)
    {
        <div class="alert alert-info">No hay accesos configurados para este modulo.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var acceso in Model.AccesosAdministrativos)
            {
                <div class="col-12 col-md-6"><article class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">@acceso.Titulo</h2><p class="text-secondary">@acceso.Descripcion</p>@if (!string.IsNullOrWhiteSpace(acceso.Controlador) && !string.IsNullOrWhiteSpace(acceso.Accion)) { @Html.ActionLink("Abrir", acceso.Accion, acceso.Controlador, null, new { @class = "btn btn-sm btn-primary" }) } else { <span class="badge text-bg-secondary">Pendiente de implementar</span> }</div></article></div>
            }
        </div>
    }
    @if (Model.UsuariosAdministrativos.Count > 0)
    {
        if (ViewBag.Aviso != null) { <div class="alert alert-info mt-4" role="status">@ViewBag.Aviso</div> }
        <section class="card shadow-sm mt-4" aria-labelledby="usuarios-title">
            <div class="card-header bg-white"><h2 id="usuarios-title" class="h5 mb-0">Cuentas registradas en Identity</h2></div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead><tr><th>Usuario</th><th>Correo</th><th>Roles</th><th>Acción</th></tr></thead>
                <tbody>
                    @foreach (var usuario in Model.UsuariosAdministrativos)
                    {
                        <tr>
                            <th scope="row">@usuario.Nombre</th><td>@usuario.Correo</td><td>@usuario.Roles</td>
                            <td>
                                @if (usuario.EsEditable)
                                {
                                    using (Html.BeginForm("CambiarRolUsuario", "Interfaces", FormMethod.Post, new { @class = "d-flex gap-2" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", usuario.Id)
                                        @Html.DropDownList("rol", new[]
                                        {
                                            new SelectListItem { Text = "Cliente", Value = "Cliente", Selected = usuario.Roles == "Cliente" },
                                            new SelectListItem { Text = "Counter", Value = "Counter", Selected = usuario.Roles == "Counter" }
                                        }, new { @class = "form-select", aria_label = "Rol para " + usuario.Nombre })
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Guardar</button>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">Cuenta protegida</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </section>
    }
</main>
