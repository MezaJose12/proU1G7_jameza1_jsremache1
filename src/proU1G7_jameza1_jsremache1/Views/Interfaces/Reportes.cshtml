@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Reportes";
    var maxReservas = Model.ReservasPorEstado.Select(e => e.Total).DefaultIfEmpty(0).Max();
    var maxCompras = Model.ComprasPorEstado.Select(e => e.Total).DefaultIfEmpty(0).Max();
}
<style>
    .report-bar { transition: width .2s ease-in-out; }
    @@media print {
        nav, footer, .aviation-background, .no-print { display: none !important; }
        body, .body-content { background: #fff !important; margin: 0 !important; padding: 0 !important; }
        .container { max-width: none !important; width: 100% !important; }
        .card { box-shadow: none !important; break-inside: avoid; }
        .progress { border: 1px solid #adb5bd; }
        a { color: #000 !important; text-decoration: none !important; }
        @@page { size: A4; margin: 14mm; }
    }
</style>
<main class="container py-4" aria-labelledby="page-title">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 21 - Administracion</p>
            <h1 id="page-title" class="h2 fw-bold">Consultas y reportes</h1>
            <p class="text-secondary mb-0">Resumen general y distribucion de reservas y compras por estado. No es un reporte financiero ni un comprobante tributario.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 no-print">
            @Html.RouteLink("Volver al panel", "AdminHome", null, new { @class = "btn btn-outline-secondary" })
            <button type="button" class="btn btn-primary" onclick="window.print()">Imprimir / Guardar PDF</button>
        </div>
    </header>

    <section class="card shadow-sm mb-4 no-print" aria-labelledby="filtro-title">
        <div class="card-body">
            <h2 id="filtro-title" class="h5">Filtrar reservas y compras por fecha de creacion</h2>
            <p class="small text-secondary">El filtro solo afecta los graficos de estados. Los conteos generales y los comprobantes incluyen todos los registros.</p>
            @using (Html.BeginForm("AdminReportes", "Interfaces", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-12 col-md-4">
                    <label class="form-label" for="desde">Desde (opcional)</label>
                    <input class="form-control" id="desde" name="desde" type="date" value="@(Model.ReporteDesde.HasValue ? Model.ReporteDesde.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="hasta">Hasta (opcional)</label>
                    <input class="form-control" id="hasta" name="hasta" type="date" value="@(Model.ReporteHasta.HasValue ? Model.ReporteHasta.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-primary">Aplicar filtro</button></div>
                <div class="col-auto">@Html.ActionLink("Limpiar", "AdminReportes", "Interfaces", null, new { @class = "btn btn-outline-secondary" })</div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ReporteAviso))
    {
        <div class="alert alert-warning" role="alert">@Model.ReporteAviso</div>
    }

    <section class="mb-4" aria-labelledby="resumen-title">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 id="resumen-title" class="h5 mb-0">Conteos generales (sin filtro de fecha)</h2>
            @Html.ActionLink("Ver comprobantes emitidos (" + Model.TotalComprobantes + ")", "Comprobantes", "Interfaces", null, new { @class = "btn btn-outline-primary no-print" })
        </div>
        <div class="row g-3">
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Vuelos programados</span><strong class="d-block fs-3">@Model.TotalVuelos</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Aeronaves</span><strong class="d-block fs-3">@Model.TotalAeronaves</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Reservas</span><strong class="d-block fs-3">@Model.TotalReservas</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Pasajeros</span><strong class="d-block fs-3">@Model.TotalPasajeros</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Compras</span><strong class="d-block fs-3">@Model.TotalCompras</strong></div></div></div>
            <div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><span class="text-secondary">Comprobantes de venta</span><strong class="d-block fs-3">@Model.TotalComprobantes</strong><span class="small text-secondary">Emitidos para compras</span></div></div></div>
        </div>
    </section>

    @if (string.IsNullOrWhiteSpace(Model.ReporteAviso))
    {
        <p class="small text-secondary">Periodo de los graficos: @(Model.ReporteDesde.HasValue ? Model.ReporteDesde.Value.ToString("dd/MM/yyyy") : "sin fecha inicial") al @(Model.ReporteHasta.HasValue ? Model.ReporteHasta.Value.ToString("dd/MM/yyyy") : "sin fecha final").</p>
        <div class="row g-4">
            <section class="col-12 col-lg-6" aria-labelledby="reservas-estado-title">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 id="reservas-estado-title" class="h5 mb-0">Reservas por estado</h2></div>
                    <div class="card-body">
                        @if (Model.ReservasPorEstado.Count == 0)
                        {
                            <p class="text-secondary mb-0">No hay reservas en el periodo seleccionado.</p>
                        }
                        @foreach (var estado in Model.ReservasPorEstado)
                        {
                            var ancho = maxReservas == 0 ? 0 : (int)Math.Round(estado.Total * 100.0 / maxReservas);
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1"><span>@estado.Estado</span><strong>@estado.Total</strong></div>
                                <div class="progress" role="progressbar" aria-label="Reservas @estado.Estado" aria-valuenow="@estado.Total" aria-valuemin="0" aria-valuemax="@maxReservas"><div class="progress-bar report-bar" style="width: @ancho%"></div></div>
                            </div>
                        }
                    </div>
                </div>
            </section>
            <section class="col-12 col-lg-6" aria-labelledby="compras-estado-title">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 id="compras-estado-title" class="h5 mb-0">Compras por estado</h2></div>
                    <div class="card-body">
                        @if (Model.ComprasPorEstado.Count == 0)
                        {
                            <p class="text-secondary mb-0">No hay compras en el periodo seleccionado.</p>
                        }
                        @foreach (var estado in Model.ComprasPorEstado)
                        {
                            var ancho = maxCompras == 0 ? 0 : (int)Math.Round(estado.Total * 100.0 / maxCompras);
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1"><span>@estado.Estado</span><strong>@estado.Total</strong></div>
                                <div class="progress" role="progressbar" aria-label="Compras @estado.Estado" aria-valuenow="@estado.Total" aria-valuemin="0" aria-valuemax="@maxCompras"><div class="progress-bar bg-success report-bar" style="width: @ancho%"></div></div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</main>
