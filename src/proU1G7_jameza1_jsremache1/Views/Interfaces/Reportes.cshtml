@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Reportes";
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 21 - Administracion</p>
            <h1 id="page-title" class="h2 fw-bold">Reportes y estadisticas</h1>
            <p class="text-secondary">Conteos de la base de datos y estado de reservas/compras por fecha de creación. No son reportes financieros ni exportables.</p>
        </div>
        @Html.RouteLink("Panel", "AdminHome", null, new { @class = "btn btn-outline-secondary" })
    </header>

    <section class="card shadow-sm mb-4" aria-labelledby="filtro-title">
        <div class="card-body">
            <h2 id="filtro-title" class="h5">Filtrar operaciones por fecha</h2>
            @using (Html.BeginForm("AdminReportes", "Interfaces", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-12 col-md-4">
                    <label class="form-label" for="desde">Desde</label>
                    <input class="form-control" id="desde" name="desde" type="date" value="@(Model.ReporteDesde.HasValue ? Model.ReporteDesde.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label" for="hasta">Hasta</label>
                    <input class="form-control" id="hasta" name="hasta" type="date" value="@(Model.ReporteHasta.HasValue ? Model.ReporteHasta.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-primary">Aplicar filtro</button></div>
                <div class="col-auto">@Html.ActionLink("Limpiar", "AdminReportes", "Interfaces", null, new { @class = "btn btn-outline-secondary" })</div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.ReporteAviso))
    {
        <div class="alert alert-warning" role="alert">@Model.ReporteAviso</div>
    }

    <div class="table-responsive card shadow-sm mb-4">
        <table class="table align-middle mb-0">
            <thead><tr><th>Indicador general</th><th class="text-end">Registros</th></tr></thead>
            <tbody>
                <tr><th scope="row">Vuelos programados</th><td class="text-end">@Model.TotalVuelos</td></tr>
                <tr><th scope="row">Aeronaves registradas</th><td class="text-end">@Model.TotalAeronaves</td></tr>
                <tr><th scope="row">Reservas</th><td class="text-end">@Model.TotalReservas</td></tr>
                <tr><th scope="row">Pasajeros</th><td class="text-end">@Model.TotalPasajeros</td></tr>
                <tr><th scope="row">Compras</th><td class="text-end">@Model.TotalCompras</td></tr>
                <tr><th scope="row">Comprobantes</th><td class="text-end">@Model.TotalComprobantes</td></tr>
            </tbody>
        </table>
    </div>

    @if (string.IsNullOrWhiteSpace(Model.ReporteAviso))
    {
        <div class="row g-4">
            <section class="col-12 col-lg-6" aria-labelledby="reservas-estado-title">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 id="reservas-estado-title" class="h5 mb-0">Reservas por estado</h2></div>
                    <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Estado</th><th class="text-end">Reservas</th></tr></thead><tbody>
                        @if (Model.ReservasPorEstado.Count == 0) { <tr><td colspan="2" class="text-secondary">Sin reservas para el periodo.</td></tr> }
                        @foreach (var estado in Model.ReservasPorEstado) { <tr><th scope="row">@estado.Estado</th><td class="text-end">@estado.Total</td></tr> }
                    </tbody></table></div>
                </div>
            </section>
            <section class="col-12 col-lg-6" aria-labelledby="compras-estado-title">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white"><h2 id="compras-estado-title" class="h5 mb-0">Compras por estado</h2></div>
                    <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Estado</th><th class="text-end">Compras</th></tr></thead><tbody>
                        @if (Model.ComprasPorEstado.Count == 0) { <tr><td colspan="2" class="text-secondary">Sin compras para el periodo.</td></tr> }
                        @foreach (var estado in Model.ComprasPorEstado) { <tr><th scope="row">@estado.Estado</th><td class="text-end">@estado.Total</td></tr> }
                    </tbody></table></div>
                </div>
            </section>
        </div>
    }
</main>
