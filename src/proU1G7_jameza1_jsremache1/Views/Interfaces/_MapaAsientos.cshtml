@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
<div class="card shadow-sm"><div class="card-body">
    <h2 class="h5">Cabina - @Model.ModeloAeronave</h2>
    <p class="small text-secondary">La proa se representa a la izquierda; los estados se expresan con color y texto.</p>
    <div class="border rounded-4 p-3 p-md-4 bg-light">
        <div class="d-flex justify-content-between small text-secondary mb-3"><span>< Proa</span><span>Bano / servicio</span></div>
        <div class="d-flex flex-column gap-3">
            @foreach (var fila in Model.Asientos.GroupBy(a => a.Fila).OrderBy(g => g.Key))
            {
                <div class="d-flex align-items-center justify-content-center gap-3">
                    @foreach (var asiento in fila.OrderBy(a => a.Codigo.EndsWith("D") ? 0 : 1))
                    {
                        var estadoVisual = (asiento.EstadoVisual ?? string.Empty).ToUpperInvariant();
                        var color = estadoVisual == "DISPONIBLE" ? "success" : estadoVisual == "RESERVADO" ? "secondary" : "danger";
                        <div class="text-center">
                            @if (ViewBag.PuedeSeleccionar == true && asiento.Seleccionable && estadoVisual == "DISPONIBLE")
                            {
                                <input class="btn-check" type="checkbox" name="asientos" id="asiento-@asiento.Codigo" value="@asiento.Codigo" autocomplete="off" />
                                <label class="btn btn-outline-@color seat-choice" for="asiento-@asiento.Codigo" title="@asiento.Ubicacion"><strong>@asiento.Codigo</strong><span class="d-block small">@asiento.Estado</span></label>
                            }
                            else
                            {
                                <span class="btn btn-@color disabled" aria-label="Asiento @asiento.Codigo: @asiento.Estado"><strong>@asiento.Codigo</strong><span class="d-block small">@asiento.Estado</span></span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="text-center text-secondary small mt-3">PASILLO</div>
    </div>
    <div class="d-flex flex-wrap gap-3 mt-3" aria-label="Leyenda de estados">
        <span><span class="badge text-bg-success">*</span> Disponible</span>
        <span><span class="badge text-bg-secondary">*</span> Reservado</span>
        <span><span class="badge text-bg-danger">*</span> Ocupado</span>
        @if (ViewBag.PuedeSeleccionar == true) { <span><span class="badge border border-dark text-success">OK</span> Su seleccion</span> }
    </div>
</div></div>
