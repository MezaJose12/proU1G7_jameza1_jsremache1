@model proU1G7_jameza1_jsremache1.Models.ReservaInterfazViewModel
@{
    ViewBag.Title = "Gestionar reserva";
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="mb-4"><p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 14 - Gestion de reserva</p><h1 id="page-title" class="h2 fw-bold">Gestionar reserva</h1></header>
    @if (Model == null)
    {
        <div class="alert alert-warning" role="alert">No se encontro la reserva o no pertenece a tu cuenta.</div>
    }
    else
    {
        <div class="alert alert-info" role="status">Esta pantalla permite consultar la reserva. Cambios, cancelaciones y reembolsos requieren reglas de negocio y persistencia que aun no se conectan en esta entrega.</div>
        <section class="card shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">@Model.CodigoReserva</h2></div><div class="card-body">
            <dl class="row"><dt class="col-sm-4">Ruta</dt><dd class="col-sm-8">@Model.Ruta</dd><dt class="col-sm-4">Fecha de viaje</dt><dd class="col-sm-8">@(Model.FechaViaje.HasValue ? Model.FechaViaje.Value.ToString("dd/MM/yyyy") : "-")</dd><dt class="col-sm-4">Pasajeros</dt><dd class="col-sm-8">@Model.CantidadPasajeros</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@Model.EstadoReserva</dd><dt class="col-sm-4">Compra</dt><dd class="col-sm-8">@Model.EstadoCompra</dd></dl>
            @if (Model.Tramos != null && Model.Tramos.Count > 0)
            {
                <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Vuelo</th><th>Ruta</th><th>Fecha</th><th>Pasajero</th><th>Asiento</th></tr></thead><tbody>@foreach (var tramo in Model.Tramos) { <tr><td>@tramo.CodigoVuelo</td><td>@tramo.Ruta</td><td>@tramo.Fecha.ToString("dd/MM/yyyy")</td><td>@tramo.NombrePasajero</td><td>@tramo.Asiento</td></tr> }</tbody></table></div>
            }
        </div></section>
        <div class="d-flex flex-wrap gap-2">@Html.RouteLink("Volver a mis reservas", "MyReservations", null, new { @class = "btn btn-outline-secondary" })@Html.RouteLink("Ver comprobantes", "Receipts", null, new { @class = "btn btn-outline-primary" })</div>
    }
</main>
