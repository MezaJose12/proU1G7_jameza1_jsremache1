@model proU1G7_jameza1_jsremache1.Models.InterfacesViewModel
@{
    ViewBag.Title = "Check-in";
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="mb-4"><p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 15 - Servicio al pasajero</p><h1 id="page-title" class="h2 fw-bold">Check-in</h1><p class="text-secondary">Consulta las reservas confirmadas asociadas a tu cuenta.</p></header>
    @if (!string.IsNullOrWhiteSpace(Model.Mensaje)) { <div class="alert alert-info" role="status">@Model.Mensaje</div> }
    @if (Model.Reservas.Count == 0)
    {
        <section class="card shadow-sm"><div class="card-body text-center py-5"><h2 class="h5">No hay reservas confirmadas</h2><p class="text-secondary">El check-in en linea solo estara disponible para vuelos elegibles.</p>@Html.RouteLink("Mis reservas", "MyReservations", null, new { @class = "btn btn-outline-primary" })</div></section>
    }
    else
    {
        <div class="row g-3">
            @foreach (var reserva in Model.Reservas)
            {
                <div class="col-12"><article class="card shadow-sm"><div class="card-body d-flex flex-column flex-md-row justify-content-between gap-3"><div><span class="badge text-bg-success">@reserva.EstadoReserva</span><h2 class="h5 mt-2">@reserva.CodigoReserva - @reserva.Ruta</h2><p class="text-secondary mb-0">@(reserva.FechaViaje.HasValue ? reserva.FechaViaje.Value.ToString("ddd dd/MM/yyyy") : "Fecha pendiente") - @reserva.CantidadPasajeros pasajero(s)</p></div><div class="align-self-md-center"><span class="badge text-bg-light border">Check-in sujeto a ventana habilitada</span></div></div></article></div>
            }
        </div>
    }
    <p class="small text-secondary mt-3">La politica de apertura y el registro de tarjetas de embarque deben integrarse antes de habilitar una accion de check-in.</p>
</main>
