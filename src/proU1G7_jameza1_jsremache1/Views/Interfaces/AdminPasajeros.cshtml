@model proU1G7_jameza1_jsremache1.Models.AdministracionPasajerosViewModel
@{
    ViewBag.Title = "Administración de pasajeros";
    var editando = Model.Formulario != null && Model.Formulario.PasajeroId.HasValue;
}
<main class="container py-4" aria-labelledby="page-title">
    <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="text-uppercase text-primary fw-semibold small mb-1">Pantalla 20 - Gestión operativa</p>
            <h1 id="page-title" class="h2 fw-bold">Administración de pasajeros</h1>
            <p class="text-secondary">Busca por nombre, documento o correo. Los registros no se eliminan para conservar el historial de reservas.</p>
        </div>
        @Html.RouteLink("Gestión", "AdminManagement", null, new { @class = "btn btn-outline-secondary" })
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Aviso))
    {
        <div class="alert alert-info" role="status">@Model.Aviso</div>
    }

    <section class="card shadow-sm mb-4" aria-labelledby="buscar-title">
        <div class="card-body">
            <h2 id="buscar-title" class="h5">Buscar pasajero</h2>
            @using (Html.BeginForm("AdminPasajeros", "Interfaces", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-12 col-md-8">
                    <label class="form-label" for="busqueda">Nombre, documento o correo</label>
                    <input class="form-control" id="busqueda" name="busqueda" value="@Model.Busqueda" minlength="3" maxlength="100" />
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-primary">Buscar</button></div>
                <div class="col-auto">@Html.ActionLink("Nuevo pasajero", "CrearPasajeroAdmin", "Interfaces", null, new { @class = "btn btn-outline-primary" })</div>
            }
        </div>
    </section>

    @if (Model.Formulario != null)
    {
        <section class="card shadow-sm mb-4" aria-labelledby="form-title">
            <div class="card-header bg-white"><h2 id="form-title" class="h5 mb-0">@(editando ? "Editar pasajero" : "Registrar pasajero")</h2></div>
            <div class="card-body">
                @Html.ValidationSummary(true, "Revisa los datos indicados.", new { @class = "alert alert-danger", role = "alert" })
                @using (Html.BeginForm(editando ? "EditarPasajeroAdmin" : "CrearPasajeroAdmin", "Interfaces", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Formulario.PasajeroId)
                    @Html.HiddenFor(m => m.Busqueda)
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Formulario.TipoDocumentoCodigo, "Tipo de documento", new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Formulario.TipoDocumentoCodigo, Model.TiposDocumento, "Seleccione", new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.Formulario.TipoDocumentoCodigo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Formulario.NumeroDocumento, "Número de documento", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.NumeroDocumento, new { @class = "form-control", maxlength = "20", minlength = "5", autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.Formulario.NumeroDocumento, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Formulario.FechaNacimiento, "Fecha de nacimiento", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.Formulario.FechaNacimiento, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Formulario.Nombres, "Nombres", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.Nombres, new { @class = "form-control", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.Formulario.Nombres, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Formulario.Apellidos, "Apellidos", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.Apellidos, new { @class = "form-control", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.Formulario.Apellidos, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Formulario.Correo, "Correo electrónico", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.Correo, new { @class = "form-control", maxlength = "256", type = "email" })
                            @Html.ValidationMessageFor(m => m.Formulario.Correo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Formulario.Telefono, "Teléfono", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Formulario.Telefono, new { @class = "form-control", maxlength = "20", type = "tel" })
                            @Html.ValidationMessageFor(m => m.Formulario.Telefono, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">@(editando ? "Guardar cambios" : "Registrar")</button>
                        @Html.ActionLink("Cancelar", "AdminPasajeros", "Interfaces", new { busqueda = Model.Busqueda }, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.Pasajeros.Count > 0)
    {
        <section class="card shadow-sm" aria-labelledby="resultados-title">
            <div class="card-header bg-white"><h2 id="resultados-title" class="h5 mb-0">Resultados (@Model.Pasajeros.Count)</h2></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Pasajero</th><th>Documento</th><th>Correo</th><th>Reservas</th><th>Acción</th></tr></thead>
                    <tbody>
                        @foreach (var pasajero in Model.Pasajeros)
                        {
                            <tr>
                                <th scope="row">@pasajero.NombreCompleto</th>
                                <td>@pasajero.TipoDocumento @pasajero.NumeroDocumento</td>
                                <td>@pasajero.Correo</td>
                                <td>@pasajero.ReservasAsociadas</td>
                                <td>@Html.ActionLink("Editar", "EditarPasajeroAdmin", "Interfaces", new { id = pasajero.PasajeroId }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</main>
